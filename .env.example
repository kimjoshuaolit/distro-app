# Client-safe config, exposed to the browser via Vite's VITE_ prefix.
# Copy this file to `.env` (gitignored) for local dev, and set the same keys
# in the Cloudflare Pages project's environment variables for production.
#
# Populated in Story 1.2, when Supabase is wired up.
#
# NEVER put secrets here. The Supabase service-role key and Cloudflare R2
# credentials live ONLY in Supabase Edge Function env — never in the client.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
