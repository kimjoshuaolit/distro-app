# Server-only secrets for Edge Functions (issue-upload-url / confirm-upload).
# These NEVER reach the browser. Copy to `supabase/functions/.env` (gitignored)
# for local dev, and set them in the Supabase project's Function secrets for prod
# (`npx supabase secrets set --env-file supabase/functions/.env`).
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# platform; you only need them locally if you serve functions standalone
# (`npx supabase functions serve --env-file supabase/functions/.env`).

# --- Cloudflare R2 (S3-compatible) — production ---
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=dispo-retro-cam
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
#
# REQUIRED R2 bucket CORS policy — guests' browsers PUT straight to R2 with a
# signed URL, so without this every upload fails (and retries forever):
#   [{ "AllowedOrigins": ["https://<your-pages-domain>"],
#      "AllowedMethods": ["PUT"],
#      "AllowedHeaders": ["content-type"],
#      "MaxAgeSeconds": 3600 }]
# (Cloudflare dashboard → R2 → bucket → Settings → CORS Policy.)

# --- Local verification against the Supabase S3-compatible storage endpoint ---
# Get the endpoint/keys from `npx supabase status` (S3 Storage URL + access keys).
# Create a private bucket named `shots` first.
# R2_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# R2_BUCKET=shots
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=local
#
# confirm-upload HEAD-checks objects from inside the function's container, where
# 127.0.0.1 is the container itself — point server-side calls at the host.
# Signing for browsers keeps using R2_ENDPOINT. Leave unset in production.
# R2_SERVER_ENDPOINT=http://host.docker.internal:54321/storage/v1/s3

# --- Operator montage upload (npm run montage:upload) ---
# The script runs on YOUR machine, not in a function, and reads this same file
# (local) or supabase/functions/.env.production (prod). Besides the R2_* keys
# above, it needs the database URL + service role key:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=
# Run from the host: R2_ENDPOINT must be reachable from your machine
# (locally http://127.0.0.1:54321/storage/v1/s3).
